<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="//code.jquery.com/jquery-3.7.1.js"></script>
    <script src="//cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="//cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css" rel="stylesheet">
 
    <title>Document</title>
</head>
<body>
    <table id="order-table" class="display">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Flavor</th>
                <th>Cone Type</th>
                <th>Toppings</th>
                <th>Comments</th>
            </tr>
        </thead>
        <tbody>
            <% orders.forEach( order => { %>
                <tr>
                    <td><%= order.name %></td>
                    <td><%= order.email %></td>
                    <td><%= order.flavor %></td>
                    <td><%= order.cone %></td>
                    <td><%= order.toppings %></td>
                    <td><%= order.comments %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
    <a href="/logout">Log out</a>
</body>
<script>
    new DataTable('#order-table', {
            responsive: true
        });
</script>
</html>